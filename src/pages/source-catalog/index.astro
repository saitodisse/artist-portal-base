---
import portal from "../../../portal.config";

const baseUrl = import.meta.env.BASE_URL;
const normalizedBaseUrl = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const withBase = (path: string) => `${normalizedBaseUrl}${path.replace(/^\/+/, "")}`;
const homeUrl = withBase("");
const manifestUrl = withBase("source-catalog/source-manifest.json");
const checksumsUrl = withBase("source-catalog/checksums.json");
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Import catalog · {portal.publicName}</title>
    <style>
      :root {
        color: #171a1d;
        background: #f4f8f7;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      body {
        margin: 0;
        background:
          linear-gradient(90deg, rgba(36, 82, 163, 0.08) 1px, transparent 1px) 0 0 / 42px 42px,
          linear-gradient(180deg, rgba(23, 26, 29, 0.06) 1px, transparent 1px) 0 0 / 100% 42px,
          #f4f8f7;
      }

      main {
        margin: 0 auto;
        max-width: 820px;
        padding: 44px 20px 72px;
      }

      h1 {
        font-size: clamp(2.2rem, 5vw, 4.4rem);
        line-height: 0.95;
        margin: 0 0 18px;
      }

      p {
        line-height: 1.72;
      }

      .copy-catalog {
        align-items: flex-start;
        display: grid;
        gap: 10px;
        justify-items: start;
        margin: 28px 0;
      }

      .copy-catalog button {
        background: linear-gradient(135deg, #2d65bf, #214c99);
        border: 1px solid #183a78;
        border-radius: 8px;
        box-shadow: 0 7px 16px rgba(36, 82, 163, 0.24);
        color: #fff;
        cursor: pointer;
        font: inherit;
        font-weight: 700;
        letter-spacing: 0.01em;
        padding: 13px 18px;
        transition: box-shadow 160ms ease, transform 160ms ease, background 160ms ease;
      }

      .copy-catalog button:hover {
        background: linear-gradient(135deg, #3673d1, #2452a3);
        box-shadow: 0 10px 22px rgba(36, 82, 163, 0.3);
        transform: translateY(-1px);
      }

      .copy-catalog button:active {
        box-shadow: 0 3px 8px rgba(36, 82, 163, 0.24);
        transform: translateY(1px);
      }

      .copy-catalog button:focus-visible,
      .actions a:focus-visible {
        outline: 3px solid #c4472f;
        outline-offset: 3px;
      }

      .copy-status {
        margin: 0;
        min-height: 1.72em;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin: 0 0 28px;
      }

      a {
        color: inherit;
      }

      .actions a {
        background: none;
        border: 0;
        border-radius: 0;
        padding: 0;
        text-decoration: underline;
        text-decoration-thickness: 1.5px;
        text-underline-offset: 3px;
      }

      code {
        background: rgba(36, 82, 163, 0.1);
        border-radius: 4px;
        padding: 2px 5px;
      }
    </style>
  </head>
  <body>
    <main>
      <p><a href={homeUrl}>Voltar ao portal</a></p>
      <h1>Import catalog</h1>
      <p>
        Este diretório é a raiz importável do catálogo estático de <strong>{portal.publicName}</strong>.
        Copie o endereço desta página e, no AC15, abra <strong>Catálogo de fonte</strong>. Cole-o no campo
        <strong>“Cole um link de catálogo por linha”</strong> e selecione <strong>“Adicionar músicas”</strong>.
      </p>
      <div class="copy-catalog">
        <button id="copy-catalog-url" type="button">Copiar endereço do catálogo</button>
        <p id="copy-status" class="copy-status" aria-live="polite"></p>
      </div>
      <div class="actions">
        <a href={manifestUrl}>source-manifest.json</a>
        <a href={checksumsUrl}>checksums.json</a>
      </div>
      <p>
        O manifesto descreve quais arquivos NDJSON devem ser baixados, seus checksums e o modo somente leitura
        do catálogo.
      </p>
    </main>
    <script>
      const copyButton = document.querySelector<HTMLButtonElement>("#copy-catalog-url");
      const copyStatus = document.querySelector<HTMLParagraphElement>("#copy-status");

      copyButton?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          if (copyStatus) copyStatus.textContent = "Endereço copiado. Cole-o no AC15 para adicionar esta fonte.";
        } catch {
          if (copyStatus) copyStatus.textContent = "Não foi possível copiar o endereço. Copie-o pela barra do navegador.";
        }
      });
    </script>
  </body>
</html>
