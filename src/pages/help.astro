---
import portal from "../../portal.config";

const baseUrl = import.meta.env.BASE_URL;
const normalizedBaseUrl = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const withBase = (path: string) => `${normalizedBaseUrl}${path.replace(/^\/+/, "")}`;
const homeUrl = withBase("");
const catalogUrl = withBase("source-catalog/");
const manifestUrl = withBase("source-catalog/source-manifest.json");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>HELP · {portal.publicName}</title>
    <style>
      :root {
        color: #171a1d;
        background: #f4f8f7;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      body {
        margin: 0;
        background:
          linear-gradient(90deg, rgba(36, 82, 163, 0.08) 1px, transparent 1px) 0 0 / 42px 42px,
          linear-gradient(180deg, rgba(23, 26, 29, 0.06) 1px, transparent 1px) 0 0 / 100% 42px,
          #f4f8f7;
      }

      main {
        margin: 0 auto;
        max-width: 920px;
        padding: 44px 20px 72px;
      }

      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 32px;
      }

      a {
        color: inherit;
      }

      nav a {
        background: rgba(255, 255, 255, 0.76);
        border: 1px solid rgba(23, 26, 29, 0.18);
        border-radius: 6px;
        padding: 10px 14px;
        text-decoration: none;
      }

      h1 {
        font-size: clamp(2.3rem, 6vw, 4.8rem);
        line-height: 0.95;
        margin: 0 0 18px;
      }

      h2 {
        border-top: 1px solid rgba(23, 26, 29, 0.16);
        font-size: 1.18rem;
        margin: 34px 0 8px;
        padding-top: 20px;
      }

      p,
      li {
        line-height: 1.72;
      }

      .lede {
        color: rgba(23, 26, 29, 0.74);
        font-size: 1.14rem;
        max-width: 760px;
      }

      .note {
        background: #fffaf0;
        border: 1px solid rgba(196, 71, 47, 0.28);
        border-radius: 8px;
        margin-top: 26px;
        padding: 16px 18px;
      }

      code {
        background: rgba(36, 82, 163, 0.1);
        border-radius: 4px;
        padding: 2px 5px;
      }
    </style>
  </head>
  <body>
    <main>
      <nav aria-label="Navigation">
        <a href={homeUrl}>Portal</a>
        <a href={catalogUrl}>Import catalog</a>
        <a href={manifestUrl}>source-manifest.json</a>
        <a href={portal.repositoryUrl}>Repository</a>
      </nav>

      <h1>HELP</h1>
      <p class="lede">
        This project is a base for one-artist portals. It turns reviewed Markdown files into a readable
        website and a static catalog that compatible apps can import.
      </p>

      <section>
        <h2>What the portal does</h2>
        <p>
          The home page reads published charts. People can search, transpose, change the font size, and
          compare a private browser draft with the published original.
        </p>
      </section>

      <section>
        <h2>Where content lives</h2>
        <p>
          The artist is in <code>catalog/artist.md</code>. Published charts are in
          <code>catalog/charts/&lt;song&gt;/&lt;version&gt;.md</code>, with YAML frontmatter followed by the chart text.
        </p>
      </section>

      <section>
        <h2>How local editing works</h2>
        <p>
          Use <code>/edit/</code> to save a draft in this browser. Saving does not publish or send it.
          Advanced copy and download actions are legacy tools for manual review; no Gateway or Protocol v2
          submission is configured.
        </p>
      </section>

      <section>
        <h2>How catalog import works</h2>
        <p>
          Import <code>{catalogUrl}</code> in a compatible app. Its <code>source-manifest.json</code> points to
          the generated artist, work, version, and chart records. This base still publishes schema 1.0.0.
        </p>
      </section>

      <section>
        <h2>How to validate a change</h2>
        <p>
          Run <code>pnpm validate</code>, <code>pnpm test</code>, <code>pnpm typecheck</code>, and
          <code>pnpm build</code> before publishing.
        </p>
      </section>

      <p class="note">
        Keep real portals easy to update from this base. Change mainly <code>portal.config.ts</code>,
        <code>catalog/</code>, and the small set of theme tokens.
      </p>
    </main>
  </body>
</html>
