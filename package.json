{
  "name": "artist-portal-base",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Base repository for static achorde artist portals and importable source catalogs.",
  "license": "MIT",
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "validate": "tsx scripts/validate-catalog.ts",
    "build:catalog": "tsx scripts/build-source-catalog.ts",
    "build": "pnpm validate && pnpm build:catalog && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "portal:init": "tsx scripts/portal-init.ts",
    "portal:create-github": "tsx scripts/portal-create-github.ts"
  },
  "dependencies": {
    "@achorde/source-catalog": "^0.1.0",
    "@achorde/tab-renderer": "^0.8.5",
    "@astrojs/react": "^5.0.0",
    "astro": "^5.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
